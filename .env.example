# QabulFlow AI — namunaviy sozlamalar. Haqiqiy kalitlar YO'Q.
# .env yaratish:  python scripts/init_env.py   (DJANGO_SECRET_KEY'ni tasodifiy yaratadi)
# Kalitsiz demo uchun hech narsani o'zgartirish shart emas: AI/STT/Telegram demo rejimida ishlaydi.
# docker-compose.yml konteyner uchun DJANGO_ENV, POSTGRES_HOST, REDIS_URL kabi qiymatlarni o'zi almashtiradi.

# --- Django ---
# development (lokal runserver) | production (gunicorn, docker)
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Demo rejimi: demo hisoblar, sintetik ma'lumotlar, demo outbox (real Telegram xabari yuborilmaydi).
# Real foydalanuvchilar bilan ishlashda false qiling.
DEMO_MODE=true

# --- PostgreSQL 16+ (pg_trgm kengaytmasi migratsiyada yoqiladi) ---
POSTGRES_DB=qabulflow
POSTGRES_USER=qabulflow
POSTGRES_PASSWORD=qabulflow
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (Celery broker + kesh) ---
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
# Redis'siz minimal lokal rejim (masalan, Windows'da Docker'siz): ikkalasini true qiling —
# kesh jarayon xotirasida, Celery vazifalari (outbox, bilim bazasi) so'rov ichida bajariladi.
# Eslatmalarni vaqtida yuborish uchun baribir Redis + celery beat kerak.
USE_LOCMEM_CACHE=false
CELERY_TASK_ALWAYS_EAGER=false

# --- AI provayder ---
# demo | anthropic | openai. Model nomi kodda qattiq yozilmagan — AI_MODEL orqali beriladi.
AI_PROVIDER=demo
# Masalan (Anthropic): claude-haiku-5-5. Provayderning amaldagi model ro'yxatini tekshiring.
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=700
AI_DAILY_TOKEN_BUDGET_PER_CONVERSATION=60000

# --- Ovozli xabar -> matn (STT) ---
# demo | openai. Masalan: STT_MODEL=whisper-1 (OPENAI_API_KEY talab qilinadi)
STT_PROVIDER=demo
STT_MODEL=
STT_MIN_CONFIDENCE=0.6
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_SECONDS=120

# --- Telegram ---
# @BotFather tokeni. Real bot uchun DEMO_MODE=false bo'lishi kerak.
TELEGRAM_BOT_TOKEN=
# polling (run_telegram_bot) | webhook (set_telegram_webhook + HTTPS manzil)
TELEGRAM_MODE=polling
TELEGRAM_ORGANIZATION_SLUG=demo-academy
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH_TOKEN=

# --- Docker (faqat docker compose) ---
WEB_PORT=8000
# HTTPS reverse-proxy ortida production uchun: true / true / 31536000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0
